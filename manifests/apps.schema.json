{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppManifests",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AppDefinition"
      }
    }
  },
  "required": [
    "apps"
  ],
  "$defs": {
    "AppDefinition": {
      "type": "object",
      "properties": {
        "default_args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "executable": {
          "type": "string"
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/PackageConfig"
        },
        "post_install": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostInstallConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_arch": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/CpuArch"
          }
        },
        "target_dir": {
          "type": "string"
        },
        "version_check": {
          "$ref": "#/$defs/VersionCheckConfig"
        }
      },
      "required": [
        "name",
        "target_dir",
        "executable",
        "version_check",
        "package"
      ]
    },
    "ArchString": {
      "description": "A string field that can be defined either as a single template string (with `{arch}`)\nor as an explicit per-architecture mapping (e.g. `{\"x64\": \"...\", \"arm64\": \"...\"}`).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "CpuArch": {
      "type": "string",
      "enum": [
        "x64",
        "arm64"
      ]
    },
    "PackageConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "nsis_7z"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "7z"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "zip"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "cab"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "msi"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "extract_subpath": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "tar"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "binary"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "PostInstallConfig": {
      "type": "object",
      "properties": {
        "create_dirs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "remove_dirs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "remove_files": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "VersionCheckConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "electron_manifest"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_key": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset_pattern": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "repo": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "github_release"
            }
          },
          "required": [
            "type",
            "repo"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json_api"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_key": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url_template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_key": {
              "$ref": "#/$defs/ArchString"
            }
          },
          "required": [
            "type",
            "url",
            "version_key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "regex": {
              "$ref": "#/$defs/ArchString"
            },
            "type": {
              "type": "string",
              "const": "regex_url"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_template": {
              "$ref": "#/$defs/ArchString"
            }
          },
          "required": [
            "type",
            "url",
            "regex",
            "url_template"
          ]
        }
      ]
    }
  }
}
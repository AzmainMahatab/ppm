{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppManifests",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AppDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "apps"
  ],
  "$defs": {
    "AppDefinition": {
      "type": "object",
      "properties": {
        "default_args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "executable": {
          "type": "string"
        },
        "global_env": {
          "description": "Environment injected when *any* app launches, not just this one. Entries carrying\nshared runtimes (engines/SDKs) own their variables here, so one block can provision\nthe whole portable environment without per-app opt-in lists.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "homepage": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/PackageConfig"
        },
        "post_install": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostInstallConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_arch": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/CpuArch"
          }
        },
        "target_dir": {
          "type": "string"
        },
        "version_check": {
          "$ref": "#/$defs/VersionCheckConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "target_dir",
        "executable",
        "version_check",
        "package"
      ]
    },
    "ArchString": {
      "description": "A string field that can be defined either as a single template string (with `{arch}`)\nor as an explicit per-architecture mapping (e.g. `{\"x64\": \"...\", \"arm64\": \"...\"}`).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "CpuArch": {
      "type": "string",
      "enum": [
        "x64",
        "arm64"
      ]
    },
    "PackageConfig": {
      "description": "How an installed package is unpacked.\n\n# Why a struct with a `type` discriminant instead of one enum variant per format\nSix of the seven formats carried an identical `extract_subpath` field, so the internally\ntagged enum repeated the same four-line serde attribute block six times. Worse, serde\nsilently ignores `deny_unknown_fields` for internally tagged enums, so a typo inside a\n`package` block was dropped without a word. A plain struct keeps the JSON shape\nbyte-for-byte identical and makes the strictness real instead of advertised.",
      "type": "object",
      "properties": {
        "extract_subpath": {
          "description": "Subdirectory of the extracted payload to install. Not meaningful for `binary`, which\nhas no archive to descend into.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/PackageKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "PackageKind": {
      "description": "The archive format a package is distributed in.",
      "type": "string",
      "enum": [
        "nsis_7z",
        "7z",
        "zip",
        "cab",
        "msi",
        "tar",
        "binary"
      ]
    },
    "PostInstallConfig": {
      "type": "object",
      "properties": {
        "create_dirs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "remove_dirs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "remove_files": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "VersionCheckConfig": {
      "oneOf": [
        {
          "description": "An electron-builder `latest.yml` update manifest.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "electron_manifest"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_key": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ]
        },
        {
          "description": "The latest release of a GitHub repository.",
          "type": "object",
          "properties": {
            "asset_pattern": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "repo": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "github_release"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "repo"
          ]
        },
        {
          "description": "A JSON document queried with ppm's path-and-predicate syntax.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json_api"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_key": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url_template": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArchString"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version_key": {
              "$ref": "#/$defs/ArchString"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "version_key"
          ]
        },
        {
          "description": "A page scraped with a regular expression whose first group is the version.",
          "type": "object",
          "properties": {
            "regex": {
              "$ref": "#/$defs/ArchString"
            },
            "type": {
              "type": "string",
              "const": "regex_url"
            },
            "url": {
              "$ref": "#/$defs/ArchString"
            },
            "url_template": {
              "$ref": "#/$defs/ArchString"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "regex",
            "url_template"
          ]
        }
      ]
    }
  }
}